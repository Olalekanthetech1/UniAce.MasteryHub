{
  "entities": {
    "Course": {
      "title": "Course",
      "description": "A university course",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Course ID (e.g., MAT101)" },
        "title": { "type": "string", "description": "Course title" },
        "description": { "type": "string", "description": "Course description" },
        "department": { "type": "string", "description": "Department area" },
        "isAIGenerated": { "type": "boolean", "description": "Whether the content was AI generated" },
        "offerings": {
          "type": "array",
          "items": {
            "$ref": "#/entities/CourseOffering"
          }
        }
      },
      "required": ["id", "title", "department"]
    },
    "CourseOffering": {
      "title": "CourseOffering",
      "description": "An explicit offering record mapping a course to a department, level, and semester",
      "type": "object",
      "properties": {
        "departmentId": { "type": "string" },
        "departmentName": { "type": "string" },
        "level": { "type": "string" },
        "semester": { "type": "string" },
        "type": { "type": "string", "enum": ["core", "elective", "global"] }
      },
      "required": ["departmentId", "level", "semester"]
    },
    "Module": {
      "title": "Module",
      "description": "A module within a course",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "courseId": { "type": "string" },
        "title": { "type": "string" },
        "order": { "type": "number" }
      },
      "required": ["id", "courseId", "title", "order"]
    },
    "Lesson": {
      "title": "Lesson",
      "description": "A lesson within a module",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "moduleId": { "type": "string" },
        "courseId": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string", "description": "Markdown content of the lesson" },
        "order": { "type": "number" }
      },
      "required": ["id", "moduleId", "courseId", "title", "content", "order"]
    },
    "Quiz": {
      "title": "Quiz",
      "description": "A quiz for a module",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "moduleId": { "type": "string" },
        "courseId": { "type": "string" },
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "type": { "type": "string", "enum": ["multiple-choice", "fill-in-the-blank"] },
              "question": { "type": "string" },
              "options": { "type": "array", "items": { "type": "string" } },
              "correctAnswer": { "type": "string" },
              "explanation": { "type": "string" },
              "hint": { "type": "string" }
            }
          }
        }
      },
      "required": ["id", "moduleId", "courseId", "questions"]
    },
    "Formula": {
      "title": "Formula",
      "description": "A mathematical formula",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "courseId": { "type": "string" },
        "title": { "type": "string" },
        "latex": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" }
      },
      "required": ["id", "courseId", "title", "latex"]
    },
    "User": {
      "title": "User",
      "description": "A user profile and progress",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "bio": { "type": "string" },
        "photoURL": { "type": "string", "format": "uri" },
        "role": { "type": "string", "enum": ["student", "admin", "editor"] },
        "fcmToken": { "type": "string" },
        "plan_type": { "type": "string", "enum": ["free", "pro", "scholar"] },
        "subscription_expiry": { "type": "string", "format": "date-time" },
        "subscription_start_date": { "type": "string", "format": "date-time" },
        "subscription_status": { "type": "string", "enum": ["active", "expired", "none"] },
        "ai_sparks": { "type": "number" },
        "xp": { "type": "number" },
        "level": { "type": "number" },
        "streak": { "type": "number" },
        "themeColor": { "type": "string" },
        "rank": { "type": "number" },
        "sessionId": { "type": "string", "description": "Unique ID for the current active session" },
        "learningProfile": {
          "type": "object",
          "properties": {
            "strengths": { "type": "array", "items": { "type": "string" } },
            "weaknesses": { "type": "array", "items": { "type": "string" } },
            "lastUpdated": { "type": "string", "format": "date-time" }
          }
        },
        "last_nudge_date": { "type": "string" },
        "last_nudge_message": { "type": "string" }
      },
      "required": ["uid", "email", "displayName", "role", "plan_type"]
    },
    "SpacedRepetition": {
      "title": "SpacedRepetition",
      "description": "Tracks a user's spaced repetition state for a specific topic or lesson",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "topicId": { "type": "string", "description": "The ID of the lesson or concept being reviewed" },
        "courseId": { "type": "string" },
        "easinessFactor": { "type": "number", "description": "SM-2 easiness factor, default 2.5" },
        "interval": { "type": "number", "description": "Current interval in days" },
        "repetitions": { "type": "number", "description": "Number of successful consecutive repetitions" },
        "nextReviewDate": { "type": "string", "format": "date-time", "description": "ISO string of when the next review is due" },
        "lastReviewed": { "type": "string", "format": "date-time" },
        "topicTitle": { "type": "string", "description": "Title of the topic for display purposes" }
      },
      "required": ["userId", "topicId", "courseId", "easinessFactor", "interval", "repetitions", "nextReviewDate", "lastReviewed", "topicTitle"]
    },
    "CurriculumCore": {
      "title": "CurriculumCore",
      "description": "The dynamic global university core curriculum benchmark for a specific discipline and level",
      "type": "object",
      "properties": {
        "discipline": { "type": "string", "description": "e.g., Computing, Engineering, Sciences" },
        "level": { "type": "string", "description": "e.g., 100, 200" },
        "coreCourses": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": { "type": "string" },
              "title": { "type": "string" },
              "units": { "type": "number" },
              "description": { "type": "string" }
            }
          }
        },
        "totalCoreUnits": { "type": "number" }
      },
      "required": ["discipline", "level", "coreCourses", "totalCoreUnits"]
    },
    "Curriculum": {
      "title": "Curriculum",
      "description": "The canonical mapping of courses for a specific department, level, and semester",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Format: DEPT_LEVEL_SEM" },
        "department": { "type": "string" },
        "level": { "type": "string" },
        "semester": { "type": "string" },
        "courseIds": { "type": "array", "items": { "type": "string" } },
        "lastUpdated": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string" }
      },
      "required": ["id", "department", "level", "semester", "courseIds", "lastUpdated"]
    },
    "IntegrityIssue": {
      "title": "IntegrityIssue",
      "description": "A system-generated log of a curriculum mismatch or data integrity problem",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "type": { "type": "string", "enum": ["MISSING_COURSE", "EXTRA_COURSE", "LEVEL_MISMATCH", "DEPT_MISMATCH", "EMPTY_CURRICULUM"] },
        "severity": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
        "details": { "type": "string" },
        "expectedCourseIds": { "type": "array", "items": { "type": "string" } },
        "actualCourseIds": { "type": "array", "items": { "type": "string" } },
        "timestamp": { "type": "string", "format": "date-time" },
        "resolved": { "type": "boolean" },
        "metadata": { "type": "object" }
      },
      "required": ["userId", "userEmail", "type", "severity", "details", "timestamp", "resolved"]
    },
    "Affiliate": {
      "title": "Affiliate",
      "description": "Tutor affiliate referral tracking",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "clicks": { "type": "number" },
        "signups": { "type": "number" },
        "paidConversions": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "clicks", "signups", "paidConversions"]
    },
    "SparkAuditLog": {
      "title": "SparkAuditLog",
      "description": "An audit log tracking spark usage transactions (such as using a 50/50 hint)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string", "format": "email" },
        "action": { "type": "string" },
        "sparksDeducted": { "type": "number" },
        "timestamp": { "type": "string", "format": "date-time" },
        "metadata": { "type": "object" }
      },
      "required": ["id", "userId", "userEmail", "action", "sparksDeducted", "timestamp"]
    },
    "SparkLedgerEntry": {
      "title": "SparkLedgerEntry",
      "description": "Immutable append-only spark escrow ledger record with idempotency token",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 160, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "idempotency_token": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "uid": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "format": "email", "maxLength": 200 },
        "action": { "type": "string", "enum": ["PRE_AUTH", "SETTLE", "REFUND", "HINT_DEDUCT", "REWARD", "ADMIN_ADJUST"] },
        "delta": { "type": "number" },
        "preAuthAmount": { "type": "number" },
        "actualCost": { "type": "number" },
        "balanceBefore": { "type": "number" },
        "balanceAfter": { "type": "number" },
        "complexity": { "type": "string", "maxLength": 32 },
        "endpoint": { "type": "string", "enum": ["http_chat", "ws_chat", "hint", "reward", "admin"] },
        "providerUsed": { "type": "string", "maxLength": 64 },
        "tokens": { "type": "number" },
        "planType": { "type": "string", "maxLength": 32 },
        "role": { "type": "string", "maxLength": 32 },
        "reason": { "type": "string", "maxLength": 500 },
        "createdAtIso": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "idempotency_token", "uid", "action", "delta", "preAuthAmount", "balanceBefore", "balanceAfter", "endpoint", "createdAtIso"]
    },
    "Challenge": {
      "title": "Challenge",
      "description": "Daily quest or arena challenge",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "desc": { "type": "string" },
        "reward": { "type": "string" },
        "xpReward": { "type": "number" },
        "sparksReward": { "type": "number" },
        "category": { "type": "string" },
        "target": { "type": "number" },
        "type": { "type": "string" },
        "active": { "type": "boolean" }
      },
      "required": ["id", "title", "desc", "reward"]
    },
    "SystemConfig": {
      "title": "SystemConfig",
      "description": "Dynamic configuration for pricing, support, and gamification",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id"]
    },
    "PublicLeaderboardEntry": {
      "title": "PublicLeaderboardEntry",
      "description": "Sanitized gamification profile for public leaderboard rankings",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "xp": { "type": "number" },
        "level": { "type": "number" },
        "streak": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "xp", "level", "streak"]
    },
    "MessageReaction": {
      "title": "MessageReaction",
      "description": "Student reaction to an AI tutor response",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "messageId": { "type": "string" },
        "userId": { "type": "string" },
        "emoji": { "type": "string" },
        "courseId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["messageId", "userId", "emoji"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Global or targeted system announcement",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "active": { "type": "boolean" },
        "severity": { "type": "string", "enum": ["info", "warning", "urgent"] },
        "audience": { "type": "string", "enum": ["all", "department", "academic_level"] },
        "targetDepartment": { "type": "string" },
        "targetLevel": { "type": "string" },
        "ctaLabel": { "type": "string" },
        "ctaUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "publishedBy": { "type": "string" },
        "impressions": { "type": "number" },
        "dismissalsCount": { "type": "number" }
      },
      "required": ["id", "title", "message", "active", "severity", "audience"]
    },
    "AnnouncementDismissal": {
      "title": "AnnouncementDismissal",
      "description": "Per-user record of dismissed announcements",
      "type": "object",
      "properties": {
        "announcementId": { "type": "string" },
        "dismissedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["announcementId", "dismissedAt"]
    },
    "AnswerReport": {
      "title": "AnswerReport",
      "description": "Student-submitted wrong-answer report queued for SME review and post-SETTLE QUALITY_BOUNTY restitution",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "messageId": { "type": "string" },
        "idempotency_token": { "type": "string" },
        "category": { "type": "string", "enum": ["final_answer_error", "derivation_step_flaw", "factual_conceptual_error", "broken_latex"] },
        "promptText": { "type": "string" },
        "modelResponseText": { "type": "string" },
        "studentCorrection": { "type": "string" },
        "questionTopicHash": { "type": "string" },
        "providerUsed": { "type": "string" },
        "upstreamModel": { "type": "string" },
        "providerLabel": { "type": "string" },
        "sparksCharged": { "type": "number" },
        "isFirstReporterForTopic": { "type": "boolean" },
        "status": { "type": "string", "enum": ["pending_review", "verified_promoted", "dismissed"] },
        "reviewerUid": { "type": "string" },
        "reviewerName": { "type": "string" },
        "reviewerNotes": { "type": "string" },
        "bountySparksAwarded": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "uid", "messageId", "category", "promptText", "modelResponseText", "status", "createdAt"]
    },
    "GoldenSetBenchmarkItem": {
      "title": "GoldenSetBenchmarkItem",
      "description": "SME-signed ground-truth benchmark question for the 150-question Golden Set evaluation harness",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "suiteType": { "type": "string", "enum": ["core_150", "regression_promoted"] },
        "split": { "type": "string", "enum": ["dev_routing", "locked_holdout"] },
        "domain": { "type": "string", "enum": ["Mathematics", "Physics", "Computer Science", "Chemistry"] },
        "topic": { "type": "string" },
        "question": { "type": "string" },
        "gradingMode": { "type": "string", "enum": ["numeric_with_tolerance", "symbolic_domain_sampling", "exact_choice", "cross_family_llm_judge"] },
        "finalAnswer": { "type": "string" },
        "groundTruthProofLatex": { "type": "string" },
        "verificationState": { "type": "string", "enum": ["human_verified", "pending_sme_signoff"] },
        "verifiedByUid": { "type": "string" },
        "verifiedByName": { "type": "string" },
        "academicCitation": { "type": "string" }
      },
      "required": ["id", "suiteType", "split", "domain", "question", "gradingMode", "finalAnswer", "groundTruthProofLatex", "verificationState", "academicCitation"]
    },
    "GoldenSetEvaluationRun": {
      "title": "GoldenSetEvaluationRun",
      "description": "Resumable production-pipeline evaluation run against SME-verified Golden Set items",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "suiteType": { "type": "string", "enum": ["core_150", "regression_promoted"] },
        "status": { "type": "string", "enum": ["running", "paused", "completed", "failed"] },
        "isOfficialRun": { "type": "boolean" },
        "officialBadgeLabel": { "type": "string" },
        "triggeredByUid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "suiteType", "status", "isOfficialRun", "triggeredByUid", "createdAt"]
    }
  },
  "firestore": {
    "/message_reactions/{reactionId}": {
      "schema": "MessageReaction",
      "description": "Student reactions (thumbs up, love, lightbulb, etc.) on AI chat responses"
    },
    "/public_leaderboard/{userId}": {
      "schema": "PublicLeaderboardEntry",
      "description": "Sanitized public leaderboard entries with zero PII exposure"
    },
    "/system_config/{configId}": {
      "schema": "SystemConfig",
      "description": "System-wide pricing, support, and gamification config"
    },
    "/challenges/{challengeId}": {
      "schema": "Challenge",
      "description": "Active daily challenges and quests"
    },
    "/curriculums/{curriculumId}": {
      "schema": "Curriculum",
      "description": "Canonical curriculum mappings"
    },
    "/integrity_issues/{issueId}": {
      "schema": "IntegrityIssue",
      "description": "System-generated logs of curriculum mismatches"
    },
    "/ccmas_cores/{coreId}": {
      "schema": "CurriculumCore",
      "description": "Global curriculum core benchmark data"
    },
    "/courses/{courseId}": {
      "schema": "Course",
      "description": "Top-level courses"
    },
    "/courses/{courseId}/modules/{moduleId}": {
      "schema": "Module",
      "description": "Modules for a specific course"
    },
    "/courses/{courseId}/modules/{moduleId}/lessons/{lessonId}": {
      "schema": "Lesson",
      "description": "Lessons within a module"
    },
    "/courses/{courseId}/modules/{moduleId}/quizzes/{quizId}": {
      "schema": "Quiz",
      "description": "Quizzes for a module"
    },
    "/courses/{courseId}/formulas/{formulaId}": {
      "schema": "Formula",
      "description": "Formulas for a course"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles and progress data"
    },
    "/users/{userId}/spaced_repetition/{topicId}": {
      "schema": "SpacedRepetition",
      "description": "User's spaced repetition data for specific topics"
    },
    "/users/{userId}/dismissals/{announcementId}": {
      "schema": "AnnouncementDismissal",
      "description": "Per-user server-side record of dismissed announcements"
    },
    "/announcements/{announcementId}": {
      "schema": "Announcement",
      "description": "Global and targeted system announcements"
    },
    "/affiliates/{affiliateId}": {
      "schema": "Affiliate",
      "description": "Tutor referral tracking data"
    },
    "/spark_audit_logs/{logId}": {
      "schema": "SparkAuditLog",
      "description": "Server-side audit logs for spark usage"
    },
    "/spark_ledger/{entryId}": {
      "schema": "SparkLedgerEntry",
      "description": "Append-only server-authoritative spark escrow ledger with idempotency keys"
    },
    "/answer_reports/{reportId}": {
      "schema": "AnswerReport",
      "description": "Student wrong-answer reports queued for SME triage and post-SETTLE QUALITY_BOUNTY restitution"
    },
    "/golden_set_benchmarks/{questionId}": {
      "schema": "GoldenSetBenchmarkItem",
      "description": "SME-verified ground-truth benchmark items for the 150-question Golden Set"
    },
    "/golden_set_runs/{runId}": {
      "schema": "GoldenSetEvaluationRun",
      "description": "Resumable production-pipeline evaluation runs with Wilson 95% CI and explicit ungraded telemetry"
    }
  }
}
