rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // UniAce Mastery Hub — Strict Server-Only Default-Deny Rules
    // ===============================================================
    // All application data (users, courses, progress, sparks, ledger,
    // analytics, configs, notifications, and RAG vectors) is served
    // authoritatively via Neon PostgreSQL and authenticated backend
    // Express/WebSocket endpoints. Direct client-side Firestore SDK
    // access is disabled across the entire frontend.
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
