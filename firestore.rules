rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email == 'uniace.support@gmail.com' || 
         request.auth.token.email == 'olalekan4565@gmail.com' ||
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'));
    }

    function isTutor() {
      return isAuthenticated() && 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'student') in ['admin', 'tutor']);
    }

    function isModerator() {
      return isAuthenticated() && 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'student') in ['admin', 'moderator']);
    }
    
    function isEditor() {
      return isTutor();
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidUser(data) {
      return data.uid == request.auth.uid &&
             (!('email' in data) || data.email == null || (data.email is string && data.email.size() < 200)) &&
             (!('displayName' in data) || data.displayName == null || (data.displayName is string && data.displayName.size() < 100)) &&
             (!('bio' in data) || data.bio == null || (data.bio is string && data.bio.size() < 500)) &&
             (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() < 100000)) &&
             (!('role' in data) || data.role == null || (data.role in ['student', 'admin', 'tutor', 'moderator'])) &&
             (!('plan_type' in data) || data.plan_type == null || (data.plan_type in ['free', 'pro', 'scholar', 'exam_cram', 'semester'])) &&
             (!('xp' in data) || data.xp == null || (data.xp is number && data.xp >= 0)) &&
             (!('level' in data) || data.level == null || (data.level is number && data.level >= 0)) &&
             (!('streak' in data) || data.streak == null || (data.streak is number && data.streak >= 0)) &&
             (!('themeColor' in data) || data.themeColor == null || (data.themeColor is string && data.themeColor.size() < 50)) &&
             (!('rank' in data) || data.rank == null || (data.rank is string && data.rank.size() < 50) || (data.rank is number && data.rank >= 0)) &&
             (!('sessionId' in data) || data.sessionId == null || (data.sessionId is string && data.sessionId.size() < 100)) &&
             (!('fcmToken' in data) || data.fcmToken == null || (data.fcmToken is string && data.fcmToken.size() < 500)) &&
             (!('lastStudyDate' in data) || data.lastStudyDate == null || (data.lastStudyDate is string && data.lastStudyDate.size() < 50)) &&
             (!('mastery' in data) || data.mastery == null || (data.mastery is map)) &&
             (!('achievements' in data) || data.achievements == null || (data.achievements is list && data.achievements.size() < 1000)) &&
             (!('studyTime' in data) || data.studyTime == null || (data.studyTime is map)) &&
             (!('topicLastStudied' in data) || data.topicLastStudied == null || (data.topicLastStudied is map)) &&
             (!('bookmarks' in data) || data.bookmarks == null || (data.bookmarks is list && data.bookmarks.size() < 1000)) &&
             (!('enrolledCourses' in data) || data.enrolledCourses == null || (data.enrolledCourses is list && data.enrolledCourses.size() < 100)) &&
             (!('assignments' in data) || data.assignments == null || (data.assignments is list && data.assignments.size() < 100)) &&
             (!('learningProfile' in data) || data.learningProfile == null || (data.learningProfile is map)) &&
             (!('last_nudge_date' in data) || data.last_nudge_date == null || (data.last_nudge_date is string && data.last_nudge_date.size() < 50)) &&
             (!('last_nudge_message' in data) || data.last_nudge_message == null || (data.last_nudge_message is string && data.last_nudge_message.size() < 1000));
    }

    function isValidStudyPlan(data) {
      return data.userId == request.auth.uid &&
             data.timetable is list && data.timetable.size() < 100 &&
             data.exams is list && data.exams.size() < 50 &&
             data.sessions is list && data.sessions.size() < 200 &&
             data.lastGenerated is string && data.lastGenerated.size() < 50 &&
             data.id is string && data.id.size() < 100;
    }

    function isValidMessage(data) {
      return data.senderId == request.auth.uid &&
             data.text is string && data.text.size() < 2000 &&
             (!('createdAt' in data) || data.createdAt is string || data.createdAt is timestamp);
    }

    function isValidSupportChat(data) {
      return data.userId == request.auth.uid &&
             (!('subject' in data) || (data.subject is string && data.subject.size() < 200)) &&
             (!('status' in data) || data.status in ['open', 'closed', 'pending']);
    }

    function isValidBattle(data) {
      return (!('creatorId' in data) || (data.creatorId is string && data.creatorId.size() < 100)) &&
             (!('opponentId' in data) || (data.opponentId is string && data.opponentId.size() < 100)) &&
             (!('status' in data) || data.status in ['waiting', 'active', 'completed', 'cancelled']) &&
             (!('courseId' in data) || (data.courseId is string && data.courseId.size() < 100));
    }

    function isValidSpacedRepetition(data) {
      return data.userId == request.auth.uid &&
             data.topicId is string && data.topicId.size() < 100 &&
             data.courseId is string && data.courseId.size() < 100 &&
             data.topicTitle is string && data.topicTitle.size() < 200 &&
             data.easinessFactor is number && data.easinessFactor >= 1.3 &&
             data.interval is number && data.interval >= 0 &&
             data.repetitions is number && data.repetitions >= 0 &&
             (data.nextReviewDate is string || data.nextReviewDate is timestamp) &&
             (data.lastReviewed is string || data.lastReviewed is timestamp);
    }

    function isValidCurriculum(data) {
      return data.id is string && data.id.size() < 100 &&
             data.department is string && data.department.size() < 100 &&
             data.level is string && data.level.size() < 10 &&
             data.semester is string && data.semester.size() < 20 &&
             data.courseIds is list && data.courseIds.size() < 100 &&
             (data.lastUpdated is string || data.lastUpdated is timestamp);
    }

    function isValidSparkAuditLog(data) {
      return data.id is string && data.id.size() < 100 &&
             data.userId is string && data.userId.size() < 100 &&
             data.userEmail is string && data.userEmail.size() < 200 &&
             data.action is string && data.action.size() < 100 &&
             data.sparksDeducted is number && data.sparksDeducted >= 0 &&
             (data.timestamp is string || data.timestamp is timestamp);
    }

    function isValidPublicLeaderboard(data) {
      return data.keys().hasOnly(['userId', 'displayName', 'photoURL', 'xp', 'level', 'streak', 'updatedAt', 'rank']) &&
             data.userId is string && data.userId.size() < 100 &&
             (!('displayName' in data) || data.displayName == null || (data.displayName is string && data.displayName.size() < 100)) &&
             (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() < 2000)) &&
             (!('xp' in data) || data.xp == null || (data.xp is number && data.xp >= 0)) &&
             (!('level' in data) || data.level == null || (data.level is number && data.level >= 0)) &&
             (!('streak' in data) || data.streak == null || (data.streak is number && data.streak >= 0)) &&
             (!('rank' in data) || data.rank == null || (data.rank is number && data.rank >= 1));
    }

    function isValidAnnouncement(data) {
      return data.title is string && data.title.size() >= 2 && data.title.size() <= 200 &&
             data.message is string && data.message.size() >= 5 && data.message.size() <= 2000 &&
             data.active is bool;
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    match /curriculums/{curriculumId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin() && isValidAnnouncement(request.resource.data);
      allow update: if (isAdmin() && isValidAnnouncement(request.resource.data)) ||
                    (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dismissalsCount', 'impressions']));
    }

    match /integrity_issues/{issueId} {
      allow read: if isAdmin() || isModerator() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow write: if isAdmin();
      allow create: if isAuthenticated(); // Allow system to log from client side
    }

    match /study_plans/{userId} {
      allow read, write: if isOwner(userId) || isAdmin() || isTutor();
    }

    match /users/{userId} {
      // Students can ONLY read their own profile; Admins & Moderators can inspect
      allow read: if isOwner(userId) || isAdmin() || isModerator();
      
      allow update: if (isAdmin() || isModerator()) && 
                      request.resource != null &&
                      resource != null &&
                      request.resource.data.uid == resource.data.uid &&
                      isValidUser(request.resource.data) &&
                      (isAdmin() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'plan_type', 'subscription_expiry', 'subscription_status', 'subscription_start_date', 'last_spark_reset', 'last_payment_ref']));
      
      allow update: if isOwner(userId) && 
                      request.resource != null &&
                      resource != null &&
                      request.resource.data.uid == resource.data.uid &&
                      request.resource.data.uid == userId &&
                      isValidUser(request.resource.data) &&
                      (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'role', 'plan_type', 'subscription_expiry', 'subscription_status', 'subscription_start_date', 'last_spark_reset', 'last_payment_ref', 'xp', 'level', 'ai_sparks', 'mastery', 'achievements', 'enrolledCourses']) || isAdmin());
      
      allow create: if isOwner(userId) && 
                      request.resource != null &&
                      request.resource.data.uid == userId &&
                      isValidUser(request.resource.data) &&
                      hasRequiredFields(['uid', 'email', 'displayName', 'role', 'plan_type']) &&
                      (request.resource.data.role == 'student' || isAdmin()) &&
                      (request.resource.data.plan_type == 'free' || isAdmin()) &&
                      (request.resource.data.get('ai_sparks', 0) <= 50 || isAdmin()) &&
                      (!('subscription_status' in request.resource.data) || request.resource.data.subscription_status == 'none' || isAdmin());

      match /flashcards/{cardId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId);
        allow update: if isOwner(userId) && request.resource != null && resource != null && request.resource.data.userId == resource.data.userId;
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /spaced_repetition/{topicId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidSpacedRepetition(request.resource.data);
        allow update: if isOwner(userId) && request.resource != null && resource != null && isValidSpacedRepetition(request.resource.data) && request.resource.data.userId == resource.data.userId;
        allow delete: if isAdmin();
      }

      match /dismissals/{announcementId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update, delete: if isOwner(userId);
      }
    }

    match /notifications/{notificationId} {
      allow read, write: if isAdmin() || isModerator();
      allow list: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow get: if isAuthenticated() && 
                    (notificationId == 'global_alert' || resource == null || resource.data.userId == request.auth.uid || resource.data.userId == 'global');
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
    }

    match /support_tickets/{ticketId} {
      allow read, write: if isAdmin() || isModerator();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /support_chats/{chatId} {
      allow read, write: if isAdmin() || isModerator();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && isValidSupportChat(request.resource.data);
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && 
                    isValidSupportChat(request.resource.data) &&
                    request.resource.data.userId == resource.data.userId;
      
      match /messages/{messageId} {
        allow read, write: if isAdmin() || isModerator();
        allow read: if isAuthenticated() && get(/databases/$(database)/documents/support_chats/$(chatId)).data.userId == request.auth.uid;
        allow create: if isAuthenticated() && 
                      get(/databases/$(database)/documents/support_chats/$(chatId)).data.userId == request.auth.uid &&
                      isValidMessage(request.resource.data);
      }
    }

    match /payments/{paymentId} {
      allow read, write: if isAdmin();
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid && 
                    (!('status' in request.resource.data) || request.resource.data.status == 'pending');
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    match /battles/{battleId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.creatorId == request.auth.uid && isValidBattle(request.resource.data);
      allow update: if isAuthenticated() && 
                    isValidBattle(request.resource.data) &&
                    (
                      (resource.data.creatorId == request.auth.uid && request.resource.data.creatorId == resource.data.creatorId) ||
                      (request.auth.uid == request.resource.data.opponentId && (!('opponentId' in resource.data) || resource.data.opponentId == request.auth.uid))
                    ) && 
                    request.resource.data.creatorId == resource.data.creatorId;
      allow delete: if isAdmin();
    }

    match /past_papers/{paperId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /ccmas_cores/{coreId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if true;
      allow write: if isEditor();

      match /{subcollection}/{docId=**} {
         allow read: if isAuthenticated();
         allow write: if isEditor();
      }
    }

    match /archived_courses/{courseId} {
      allow read: if isAuthenticated();
      allow write: if isEditor();
    }

    match /analytics/{docId} {
      allow read, write: if isAdmin() || isTutor();
    }

    match /settings/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /system_settings/{configId} {
      allow read, write: if isAdmin();
    }

    match /system_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /challenges/{challengeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /formulas/{formulaId} {
      allow read: if isAuthenticated();
      allow write: if isEditor();
    }

    match /system_logs/{logId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /knowledge_base/{docId} {
      allow read: if isAuthenticated();
      allow write: if isEditor();
    }

    match /test/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /public_leaderboard/{userId} {
      // Readable by authenticated students; zero access to private user documents or fields
      allow read: if isAuthenticated();
      // Only Admin / Backend SDK can write to public_leaderboard with strict sanitized schema
      allow write: if isAdmin() && isValidPublicLeaderboard(request.resource.data);
    }

    match /affiliates/{affiliateId} {
      // Authenticated users can read their own affiliate record or check non-existent records safely; Admins can read all
      allow read: if isAdmin() || (isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid));
      allow write: if isAdmin();
      allow update: if isAuthenticated() &&
                    resource != null &&
                    request.resource != null &&
                    request.resource.data.userId == resource.data.userId &&
                    (!('code' in resource.data) || request.resource.data.code == resource.data.code) &&
                    (!('refCode' in resource.data) || request.resource.data.refCode == resource.data.refCode) &&
                    (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt) &&
                    (!('commissionRate' in resource.data) || request.resource.data.commissionRate == resource.data.commissionRate) &&
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['signups', 'paidConversions']) &&
                    (
                      (request.resource.data.signups == resource.data.signups + 1) ||
                      (request.resource.data.paidConversions == resource.data.paidConversions + 1)
                    );
    }

    match /curriculum_requests/{requestId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    
    match /payout_requests/{requestId} {
      // Authenticated users can read their own payout requests or check non-existent requests; Admins can read all
      allow read: if isAdmin() || (isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid));
      allow create: if false; // Through backend
      allow update, delete: if isAdmin();
    }

    match /spark_audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() || (isAuthenticated() && isValidSparkAuditLog(request.resource.data));
      allow update, delete: if isAdmin();
    }

    match /message_reactions/{reactionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /message_reaction_tallies/{messageId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /system_math_telemetry/{telemetryId} {
      allow read: if isAdmin();
      allow write: if false; // Only written via backend server SDK
    }

    match /spark_ledger/{entryId} {
      allow get: if isAdmin() || (isAuthenticated() && resource != null && resource.data.uid == request.auth.uid);
      allow list: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow write, create, update, delete: if false; // Strictly server-only state machine via Firebase Admin SDK
    }

    match /chat_analytics/{analyticsId} {
      allow read: if isAdmin();
      allow write, create, update, delete: if false; // Strictly server-only telemetry via Firebase Admin SDK
    }

    match /answer_reports/{reportId} {
      allow get: if isAdmin() || isTutor() || (isAuthenticated() && resource != null && resource.data.uid == request.auth.uid);
      allow list: if isAdmin() || isTutor() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow write, create, update, delete: if false; // Strictly server-only via /api/chat/report-wrong and /api/admin/answer-reports/:id/triage
    }

    match /golden_set_benchmarks/{questionId} {
      allow read: if isAdmin() || isTutor();
      allow write, create, update, delete: if false; // Strictly server-only via SME Corpus Manager endpoints
    }

    match /golden_set_runs/{runId} {
      allow read: if isAdmin() || isTutor();
      allow write, create, update, delete: if false; // Strictly server-only via Resumable Golden Set Evaluator
    }
  }
}
